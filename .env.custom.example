### Custom release image
CUSTOM_BACKEND_IMAGE=ghcr.io/fourgetu/remnawave-backend:custom-v0.2.0

### Application
APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1
APP_SECRET=replace-with-a-long-random-secret

### Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@remnawave-db:5432/postgres

### Valkey socket
REDIS_SOCKET=/var/run/valkey/valkey.sock

### Domains; do not add a trailing slash
PANEL_DOMAIN=panel.example.com
FRONT_END_DOMAIN=https://panel.example.com
SUB_PUBLIC_DOMAIN=panel.example.com/api/sub

### Notifications (optional)
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_USERS=
TELEGRAM_NOTIFY_NODES=
TELEGRAM_NOTIFY_CRM=
TELEGRAM_NOTIFY_SERVICE=
TELEGRAM_NOTIFY_TBLOCKER=

### Metrics authentication (keep the metrics endpoint private)
METRICS_USER=admin
METRICS_PASS=replace-with-a-metrics-password

### Optional webhook
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET_HEADER=
